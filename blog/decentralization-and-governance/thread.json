  },
  "display_text_range": [
   "0",
   "206"
  ],
  "favorite_count": "68",
  "in_reply_to_status_id_str": "1490787677272223746",
  "id_str": "1490789447528595457",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "7",
  "id": "1490789447528595457",
  "in_reply_to_status_id": "1490787677272223746",
  "created_at": "Mon Feb 07 20:47:56 +0000 2022",
  "favorited": false,
  "full_text": "Secondly: Brantly is still the top delegate. Second is Coinbase, an entity who has a contract for “analytics”with the US homeland security and is, in my opinion, much more problematic than he could ever be.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "1490789449428525060"
    ],
    "editableUntil": "2022-02-07T21:47:56.929Z",
    "editsRemaining": "5",
    "isEditEligible": true
   }
  },
  "retweeted": false,
  "source": "<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>",
  "entities": {
   "hashtags": [],
   "symbols": [],
   "user_mentions": [],
   "urls": []
  },
  "display_text_range": [
   "0",
   "269"
  ],
  "favorite_count": "27",
  "in_reply_to_status_id_str": "1490789447528595457",
  "id_str": "1490789449428525060",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "0",
  "id": "1490789449428525060",
  "in_reply_to_status_id": "1490789447528595457",
  "created_at": "Mon Feb 07 20:47:56 +0000 2022",
  "favorited": false,
  "full_text": "Most of the other top 10 delegates (including me) could probably be found in the same table at some random devcon a few years ago. Is that a good thing for diversity of opinions and experiences? It can also be very expensive to redelegate, which is not very democratic.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "1490789451563511823"
    ],
    "editableUntil": "2022-02-07T21:47:57.438Z",
    "editsRemaining": "5",
    "isEditEligible": true
   }
  },
  "retweeted": false,
  "source": "<a href=\"http://twitter.com/#!/download/ipad\" rel=\"nofollow\">Twitter for iPad</a>",
  "entities": {
   "hashtags": [],
   "symbols": [],
