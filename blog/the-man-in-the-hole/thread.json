  "id": "1564282389387427840",
  "in_reply_to_status_id": "1564282386728222724",
  "created_at": "Mon Aug 29 16:02:39 +0000 2022",
  "favorited": false,
  "full_text": "From 1995 to 2006 Santos organized many expeditions to contact the sole survivor of the lost tribe. During one of these one of the expedition members was shot with arrows. After this they ceased any attempt of contact and created an 80km isolation area around him.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
