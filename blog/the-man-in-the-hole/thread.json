  "id_str": "1564282401701986308",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "1564282401701986308",
  "in_reply_to_status_id": "1564282397453074435",
  "created_at": "Mon Aug 29 16:02:42 +0000 2022",
  "favorited": false,
  "full_text": "The Man, whose own name we never learned, was found dead in his tent this weekend. He was found in his hammock, with a special ceremonial paint, as if he knew his time was near. Exact cause of death is to be determined but it seems to be from natural causes. He was about 50yo.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "1564282405103570945"
    ],
    "editableUntil": "2022-08-29T16:32:42.000Z",
