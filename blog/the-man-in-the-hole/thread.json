  },
  "display_text_range": [
   "0",
   "258"
  ],
  "favorite_count": "20",
  "in_reply_to_status_id_str": "1564282401701986308",
  "id_str": "1564282405103570945",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "1564282405103570945",
  "in_reply_to_status_id": "1564282401701986308",
  "created_at": "Mon Aug 29 16:02:42 +0000 2022",
  "favorited": false,
  "full_text": "After the autopsy, his body is to be returned to his land to be buried.\n\nAlong with his name, we will never know what he called his tribe, language they spoke, what they believed about death or whatever burial ceremony they had, nor the purpose of the holes.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
