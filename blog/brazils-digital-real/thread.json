  "favorite_count": "16",
  "in_reply_to_status_id_str": "1650506191536095233",
  "id_str": "1650506917322670082",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "1650506917322670082",
  "in_reply_to_status_id": "1650506191536095233",
  "created_at": "Mon Apr 24 14:28:08 +0000 2023",
  "favorited": false,
  "full_text": "They are fans of DAOs, NFTs, AMMs and all the Ethereum ecosystem innovations, and want to bring them to the national government.\n\nOne national chain for everything, ran by multiple nongovernmental institutions. Not revolutionary, but quite evolutionary in my opinion.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
