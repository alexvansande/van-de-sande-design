  "favorite_count": "29",
  "in_reply_to_status_id_str": "1650505593184976903",
  "id_str": "1650505595449909249",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "2",
  "id": "1650505595449909249",
  "in_reply_to_status_id": "1650505593184976903",
  "possibly_sensitive": false,
  "created_at": "Mon Apr 24 14:22:53 +0000 2023",
  "favorited": false,
  "full_text": "They're dead serious about it: besides working with Consensys' Besu they have selected Aave as one of their development partners. \n\nOne of their stated goal is to make this local network 100% compatible with the EVM ecosystem and to bridge to it.\n\nhttps://t.co/UDttZ5tplT",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "1650506191536095233"
    ],
    "editableUntil": "2023-04-24T14:55:15.000Z",
    "editsRemaining": "5",
    "isEditEligible": false
   }
  },
  "retweeted": false,
  "source": "<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>",
  "entities": {
   "hashtags": [],
