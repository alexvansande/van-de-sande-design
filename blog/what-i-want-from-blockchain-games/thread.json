  "in_reply_to_status_id": "990400870016745472",
  "created_at": "Sun Apr 29 01:22:26 +0000 2018",
  "favorited": false,
  "full_text": "2) embrace what makes blockchain unique \n\nDon’t try to make a shooter or something that requires speed. Think about what sort of experience you can create that you couldn’t in any other platform",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
