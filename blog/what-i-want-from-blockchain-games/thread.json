  "in_reply_to_status_id": "990400885426741248",
  "created_at": "Sun Apr 29 01:22:27 +0000 2018",
  "favorited": false,
  "full_text": "3) design around the limitations \n\nOnly have few moves per second? Then make it strategic turns. Can’t have secret information? Make a commit reveal scheme as part of the game. Moves are expensive? Figure out what actually needs consensus. Need unexplored regions? PoW maps.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
