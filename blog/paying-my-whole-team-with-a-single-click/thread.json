  "display_text_range": [
   "0",
   "278"
  ],
  "favorite_count": "34",
  "in_reply_to_status_id_str": "1091337946043686912",
  "id_str": "1091337947578880006",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "2",
  "id": "1091337947578880006",
  "in_reply_to_status_id": "1091337946043686912",
  "possibly_sensitive": false,
  "created_at": "Fri Feb 01 14:10:17 +0000 2019",
  "favorited": false,
  "full_text": "As a final touch, I set the default function to pay all amounts due and be public, so it allows a service like ethereum alarm clock to schedule a call for a given day of the month. We recently tested today and it all worked like a charm. Here's the code:\nhttps://t.co/hU23mJdXmw",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 }
]