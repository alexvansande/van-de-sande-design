  "retweet_count": "5",
  "id": "1091337932894597120",
  "in_reply_to_status_id": "1091337929362952192",
  "created_at": "Fri Feb 01 14:10:13 +0000 2019",
  "favorited": false,
  "full_text": "I spent a half a day and was able to build a contract that keeps DAI in compound, but withdraws when it wants to make specific payments. I added yearly salaries of all team members and spent another half day in making a nice interface so they can request payment at anytime.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
