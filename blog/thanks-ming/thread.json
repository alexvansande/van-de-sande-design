  "favorite_count": "30",
  "in_reply_to_status_id_str": "958851797678022660",
  "id_str": "958851802211979264",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "2",
  "id": "958851802211979264",
  "in_reply_to_status_id": "958851797678022660",
  "created_at": "Wed Jan 31 23:57:38 +0000 2018",
  "favorited": false,
  "full_text": "The network was live, but we still needed years of development and the money was running out. We had ether, but it was still under $1. They asked  Geth devs (and therefore Mist) to take a 10% haircut, mgmt took more.  CPP team was almost all cut out. Everyone was feeling down.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
