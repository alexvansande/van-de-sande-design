  "in_reply_to_status_id": "958851787649318913",
  "created_at": "Wed Jan 31 23:57:37 +0000 2018",
  "favorited": false,
  "full_text": "Bitcoin price fell from 600 to 300 just after the presale,  before we could touch most of it so right there half of the money we had raised was gone. The other half was spent developing the clients and launching the network, by August.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
