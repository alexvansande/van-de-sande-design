  "in_reply_to_status_id": "958851806179807238",
  "created_at": "Wed Jan 31 23:57:42 +0000 2018",
  "favorited": false,
  "full_text": "Then, by the end of 2015, things started turning around. The multiple entities were closed and our haircuts were buying us time. Ming spent most of her time cleaning up an excessive and expensive legal infrastructure and going through audits and hell of paperwork.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
