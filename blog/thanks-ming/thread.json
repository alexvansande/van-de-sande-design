  "in_reply_to_status_id": "958851815197560842",
  "created_at": "Wed Jan 31 23:57:42 +0000 2018",
  "favorited": false,
  "full_text": "Then Devcon 1 came around (Devcon 0 was a internal developers only get together in Berlin), and Microsoft was a sponsor, Nick Szabo was giving a keynote, it was a clear message that the industry took us seriously.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
