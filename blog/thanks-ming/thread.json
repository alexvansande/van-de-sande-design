  "favorite_count": "41",
  "in_reply_to_status_id_str": "958851802211979264",
  "id_str": "958851806179807238",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "3",
  "id": "958851806179807238",
  "in_reply_to_status_id": "958851802211979264",
  "created_at": "Wed Jan 31 23:57:39 +0000 2018",
  "favorited": false,
  "full_text": "Back then, many still thought ethereum was a scam/vaporware and never going to launch. We proved them wrong. But as local saying, we had swimmed, swimmed and were about to die on the beach.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
