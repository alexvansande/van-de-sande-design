  "favorited": false,
  "full_text": "We built what we thought the world needed, not what it wanted. \nThat’s why we failed.",
  "lang": "en"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "2072062783227670804"
    ],
    "editableUntil": "2026-06-30T22:00:39.000Z",
    "editsRemaining": "5",
    "isEditEligible": false
   }
  },
  "retweeted": false,
  "source": "<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>",
  "entities": {
   "hashtags": [],
   "symbols": [],
