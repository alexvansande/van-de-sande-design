   "274"
  ],
  "favorite_count": "36",
  "in_reply_to_status_id_str": "2072062785454829885",
  "id_str": "2072062787631645097",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "2072062787631645097",
  "in_reply_to_status_id": "2072062785454829885",
  "created_at": "Tue Jun 30 21:00:40 +0000 2026",
  "favorited": false,
  "full_text": "The other day I was reading the docs to invest in a promising startup and realized my money was going to a fund, structured like an spv, who owned shares in a cayman corp, who had a deal with a Delaware llc who was three levels away from the actual cap table. It’s standard.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
