   "urls": []
  },
  "display_text_range": [
   "0",
   "105"
  ],
  "favorite_count": "28",
  "in_reply_to_status_id_str": "2072062783227670804",
  "id_str": "2072062785454829885",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "0",
  "id": "2072062785454829885",
  "in_reply_to_status_id": "2072062783227670804",
  "created_at": "Tue Jun 30 21:00:39 +0000 2026",
  "favorited": false,
  "full_text": "The world wanted penny stocks and ape pictures. They wanted quick money and cassinos that were open 24/7.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "2072062787631645097"
    ],
