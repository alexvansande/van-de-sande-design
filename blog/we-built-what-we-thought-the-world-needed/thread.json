   "urls": []
  },
  "display_text_range": [
   "0",
   "264"
  ],
  "favorite_count": "28",
  "in_reply_to_status_id_str": "2072053903420461321",
  "id_str": "2072062783227670804",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "2072062783227670804",
  "in_reply_to_status_id": "2072053903420461321",
  "created_at": "Tue Jun 30 21:00:39 +0000 2026",
  "favorited": false,
  "full_text": "We wanted organizations that would live in the cloud and only follow hard rules. We built a property ledger that could be used by anyone to manage anything. We wanted an open backend for an open internet. We built a way for people to invest directly into anything.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
  "edit_info": {
   "initial": {
    "editTweetIds": [
     "2072062785454829885"
    ],
    "editableUntil": "2026-06-30T22:00:39.000Z",
    "editsRemaining": "5",
    "isEditEligible": false
   }
  },
  "retweeted": false,
  "source": "<a href=\"https://mobile.twitter.com\" rel=\"nofollow\">Twitter Web App</a>",
  "entities": {
   "hashtags": [],
   "symbols": [],
