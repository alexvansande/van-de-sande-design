  "favorite_count": "66",
  "in_reply_to_status_id_str": "2072062787631645097",
  "id_str": "2072062789720371202",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "5",
  "id": "2072062789720371202",
  "in_reply_to_status_id": "2072062787631645097",
  "created_at": "Tue Jun 30 21:00:40 +0000 2026",
  "favorited": false,
  "full_text": "We built a better system in 2016. You could buy directly from founders, own directly in your wallet, liquid. \n\nThe world used it for pumping scams. Nobody else ever wanted to touch that.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
 {
