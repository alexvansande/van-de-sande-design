  "truncated": false,
  "retweet_count": "0",
  "id": "2072114109823307911",
  "in_reply_to_status_id": "2072113765429252171",
  "created_at": "Wed Jul 01 00:24:36 +0000 2026",
  "favorited": false,
  "full_text": "I would say the ENS DAO was the model of how everything else should work: transparent, hard rules, uncorruptable. \n\nBut the problem is that people are hard to govern, even under the best rules. And we ended up reinventing a lot of existing governance structures to fix our own…",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
