  ],
  "favorite_count": "19",
  "in_reply_to_status_id_str": "1008501163040354309",
  "id_str": "1008501165154283520",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "3",
  "id": "1008501165154283520",
  "in_reply_to_status_id": "1008501163040354309",
  "created_at": "Mon Jun 18 00:06:29 +0000 2018",
  "favorited": false,
  "full_text": "Were these lessons valuable? Definitely. Could we have learned them by other ways? Probably. Was the stress, the distractions, the change in culture, the community split worth the cost of learning them? I don’t think so anymore.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 }
]