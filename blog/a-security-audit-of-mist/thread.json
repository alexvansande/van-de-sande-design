  "created_at": "Fri Sep 11 18:42:21 +0000 2020",
  "favorited": false,
  "full_text": "This was fundamentally the end of the project. We explored  different approaches, using other frameworks, building our own, starting from scratch on a completely different language. We saw Brave pop up and eventually abandon Electron too. In a year Mist would be discontinued.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
