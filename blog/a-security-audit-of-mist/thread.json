  "id_str": "1304483991903404034",
  "in_reply_to_user_id": "10157",
  "truncated": false,
  "retweet_count": "1",
  "id": "1304483991903404034",
  "in_reply_to_status_id": "1304483990078881792",
  "created_at": "Fri Sep 11 18:16:34 +0000 2020",
  "favorited": false,
  "full_text": "However the first 2 years I worked on Ethereum we were mostly focused on the Wallet app, so it started being released as a beta in 2016 and we started a security audit at the same time. The Foundation contacted Mario Heiderich from Cure53.\n\nIt was a great piece of humble pie.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
