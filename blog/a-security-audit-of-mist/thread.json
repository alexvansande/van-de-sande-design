  "in_reply_to_status_id": "1304485475168784386",
  "created_at": "Fri Sep 11 18:33:08 +0000 2020",
  "favorited": false,
  "full_text": "At this point everything was fixable. But at some point they started going deeper into our tech stack: you could force an error in Node.js to reveal information about the user’s folder names. You could abuse our injected provider and override the native JSON parser functions.",
  "lang": "en",
  "in_reply_to_screen_name": "avsa",
  "in_reply_to_user_id_str": "10157"
 },
